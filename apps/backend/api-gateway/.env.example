PORT=4000
JWT_SECRET=dev-only-change-me
INTERNAL_KEY=dev-internal-key-change-me
AUTH_SERVICE_URL=http://localhost:4001
EMPRESAS_SERVICE_URL=http://localhost:4002
EVALUACIONES_SERVICE_URL=http://localhost:4003
NOTIFICACIONES_SERVICE_URL=http://localhost:4004
REDIS_URL=redis://localhost:6379
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SEED_RATE_LIMIT_MAX=20
SEED_RATE_LIMIT_WINDOW_SECONDS=60
RECUPERAR_RATE_LIMIT_MAX=5
RECUPERAR_RATE_LIMIT_WINDOW_SECONDS=300
FRONTEND_URL=http://localhost:3001
# Solo activar en producción real, detrás de un proxy/load balancer que ya termina TLS.
ENFORCE_HTTPS=false

# "Signing secret" del webhook de Resend Inbound (dashboard de Resend → Webhooks →
# tu endpoint → Signing Secret, empieza con "whsec_"). Sin ella, POST
# /correos-entrantes/webhook rechaza todo con 401 en vez de guardar sin verificar.
RESEND_WEBHOOK_SECRET=

# Tope de reportes de soporte por usuario, para que nadie inunde el buzón del administrador.
SOPORTE_RATE_LIMIT_MAX=5
SOPORTE_RATE_LIMIT_WINDOW_SECONDS=600
