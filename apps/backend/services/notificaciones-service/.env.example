PORT=4004
DATABASE_URL=postgresql://leanstart:leanstart@localhost:5432/leanstart_notificaciones
INTERNAL_KEY=dev-internal-key-change-me

# auth-service — para resolver el correo del destinatario de cada notificación.
AUTH_SERVICE_URL=http://localhost:4001

# URL pública del frontend — se usa para armar el enlace del correo (a la pantalla de
# notificaciones del rol correspondiente).
FRONTEND_URL=http://localhost:3001

# API key de Resend (resend.com) para el correo de cada notificación. Sin ella, no se
# manda correo (el aviso in-app se sigue creando igual — no revienta).
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado en Resend, deja el de pruebas de abajo.
RESEND_FROM_EMAIL=LeanStart <onboarding@resend.dev>
