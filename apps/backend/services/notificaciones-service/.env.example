PORT=4004
DATABASE_URL=postgresql://leanstart:leanstart@localhost:5432/leanstart_notificaciones
INTERNAL_KEY=dev-internal-key-change-me

# auth-service — para resolver el correo del destinatario de cada notificación.
AUTH_SERVICE_URL=http://localhost:4001

# URL pública del frontend — se usa para armar el enlace del correo (a la pantalla de
# notificaciones del rol correspondiente).
FRONTEND_URL=http://localhost:3001

# API key de Resend (resend.com) para el correo de cada notificación. Sin ella, no se
# manda correo (el aviso in-app se sigue creando igual — no revienta).
RESEND_API_KEY=
# Dirección de SALIDA — todo lo que manda LeanStart sale de aquí y nadie lee esta
# casilla. Requiere leanstart.online verificado en Resend (si aún no lo está, usa
# el remitente de pruebas "LeanStart <onboarding@resend.dev>", que solo entrega al
# correo dueño de la cuenta de Resend).
RESEND_FROM_EMAIL=LeanStart <soporte@leanstart.online>

# Dirección de ENTRADA — el aviso de cada reporte se manda aquí. Vive en el
# dominio de Resend Inbound, así que "recibir" significa entrar por el webhook y
# quedar archivado en /administrador/soporte, no una bandeja que se abra a mano.
SOPORTE_EMAIL=admin@soporte.leanstart.online

# Subdominio dado de alta en Resend Inbound. Con él, cada reporte se anuncia con
# replyTo = reporte-<id>@<este dominio>: al responder, el correo vuelve por el
# webhook, queda archivado en el hilo del reporte y se reenvía a la otra parte.
# Vacío = las respuestas van directo al correo del usuario, sin quedar registradas.
# SOPORTE_EMAIL vive en este mismo dominio a propósito: el aviso vuelve por el
# webhook y CorreosEntrantesService lo descarta por venir de RESEND_FROM_EMAIL.
SOPORTE_INBOUND_DOMAIN=soporte.leanstart.online
