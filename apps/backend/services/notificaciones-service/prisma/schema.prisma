generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Notificacion {
  id                  String   @id @default(uuid())
  tipo                String
  destinatarioUserId  String
  titulo              String
  mensaje             String
  empresaNombre       String?
  /// Para deduplicar: si ya hay una sin leer del mismo tipo+empresa+destinatario,
  /// no se crea otra (ver NotificacionesService.crear).
  empresaId           String?
  leida               Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([destinatarioUserId])
  @@map("notificaciones")
}

/// Correos que llegan a la casilla de recepción de Resend (Inbound) — el
/// api-gateway verifica la firma del webhook y reenvía el evento ya validado
/// acá. Solo se guarda el metadata, para tener registro de que llegó. No está
/// conectado al buzón de soporte: ese vive completo dentro de la aplicación.
model CorreoEntrante {
  id             String   @id @default(uuid())
  /// Id que le da Resend al correo — evita duplicarlo si reintenta el webhook.
  resendId       String   @unique
  remitente      String
  destinatarios  String[]
  asunto         String
  recibidoEn     DateTime
  procesado      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([procesado])
  @@map("correos_entrantes")
}

/// Reporte del botón de soporte técnico (Mi perfil → Soporte técnico).
/// El buzón vive entero dentro de la aplicación: no se manda ni se recibe
/// correo por este flujo, el administrador los lee en /administrador/soporte.
model ReporteSoporte {
  id           String   @id @default(uuid())
  autorUserId  String
  /// Nombre y correo se copian al crear, no se resuelven al leer: si el usuario
  /// cambia de correo o se da de baja, el reporte conserva a quién contestarle.
  autorNombre  String
  autorCorreo  String
  autorRoles   String[]
  asunto       String
  mensaje      String
  navegador    String?
  /// nuevo | atendido
  estado       String   @default("nuevo")
  atendidoEn   DateTime?
  createdAt    DateTime @default(now())

  @@index([estado, createdAt])
  @@map("reportes_soporte")
}
