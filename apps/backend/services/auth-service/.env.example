PORT=4001
DATABASE_URL=postgresql://leanstart:leanstart@localhost:5432/leanstart_auth
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d
INTERNAL_KEY=dev-internal-key-change-me
# URL pública del frontend — se usa para armar el enlace de recuperación de contraseña.
FRONTEND_URL=http://localhost:3001
# API key de Resend (resend.com) para el correo de recuperación de contraseña.
# Sin ella, el enlace solo se registra en el log (útil en local sin cuenta).
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado en Resend, deja el de pruebas de abajo.
RESEND_FROM_EMAIL=LeanStart <onboarding@resend.dev>
