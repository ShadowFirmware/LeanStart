generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  nombre       String
  correo       String   @unique
  passwordHash String
  /// Rol principal = roles[0]; se mantiene sincronizado para que cualquier
  /// código que todavía lea `rol` (en vez de `roles`) siga funcionando.
  rol          String
  /// Fuente de verdad para autorización: un usuario puede tener varios roles
  /// a la vez (ej. emprendedor + mentor). Nunca vacío.
  roles        String[]
  estado       String   @default("activo")
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  semillasAlexa SemillaAlexa[]
  resetTokens   PasswordResetToken[]
  privilegiosOverride UsuarioPrivilegio[]

  @@map("users")
}

/// Recuperación de contraseña: token de un solo uso enviado por correo (ver
/// EmailService), expira a la hora. AuthService.restablecer lo consume para
/// fijar un passwordHash nuevo sin necesitar la contraseña anterior.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiraAt  DateTime
  usadoAt   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

/// Login por voz de la skill de Alexa: el emprendedor genera una semilla de 4
/// dígitos desde la web (ya autenticado) y se la dicta a Alexa junto con el
/// nombre que eligió; la skill la cambia por un access token real vía
/// POST /auth/seeds/validate. Un solo uso (usadaAt) y expira a los 15 min.
model SemillaAlexa {
  id          String    @id @default(uuid())
  userId      String
  nombre      String
  seed        String
  generatedAt DateTime  @default(now())
  expiraAt    DateTime
  usadaAt     DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([nombre, seed])
  @@map("semillas_alexa")
}

/// Matriz módulo+acción por rol. rolId = nombre literal del rol para los 4 roles
/// base del sistema (coincide con Role); en el futuro podría ser el uuid de un
/// rol personalizado, sin cambios de esquema.
model Privilegio {
  id     String @id @default(uuid())
  rolId  String
  modulo String
  accion String

  @@unique([rolId, modulo, accion])
  @@map("privilegios")
}

/// Excepción puntual a los privilegios que un usuario recibiría solo por sus
/// roles: `otorgado=true` le da una acción que su(s) rol(es) no incluyen,
/// `otorgado=false` le quita una que sí incluyen. Sin fila = usa el default
/// del rol. Solo se guardan las diferencias, así que cambiar los roles de un
/// usuario no descarta sus excepciones (pueden dejar de aplicar si el módulo
/// ya no es relevante, pero no se pierden).
model UsuarioPrivilegio {
  id       String  @id @default(uuid())
  userId   String
  modulo   String
  accion   String
  otorgado Boolean

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, modulo, accion])
  @@map("usuario_privilegios")
}
